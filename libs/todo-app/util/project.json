{
    "name": "todo-app-util",
    "$schema": "../../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/todo-app/util/src",
    "prefix": "angular-monorepo",
    "tags": ["type:util", "scope:todo-app"],
    "projectType": "library",
    "targets": {
